// ============================================================
//  DressSense - Prisma schema (MySQL)
//  Mô hình dữ liệu cho hệ thống TMĐT thời trang cá nhân hóa AI
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Người dùng & phân quyền (UC1) ----------
enum Role {
  CUSTOMER
  SELLER
  ADMIN
}

// Trạng thái tài khoản
enum AccountStatus {
  ACTIVE            // đã kích hoạt (Khách hàng sau xác thực)
  PENDING_APPROVAL  // Người bán chờ Quản trị viên kiểm duyệt (UC16.3)
  LOCKED            // tạm khóa (vd brute-force)
  DISABLED          // vô hiệu hóa
}

// Phương thức xác thực
enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id        Int           @id @default(autoincrement())
  email     String?       @unique
  phone     String?       @unique
  password  String?       // null nếu đăng nhập qua mạng xã hội (OAuth)
  fullName  String
  avatarUrl String?
  role      Role          @default(CUSTOMER)
  status    AccountStatus @default(ACTIVE)
  provider  AuthProvider  @default(LOCAL)

  // Cổng Người bán: tên gian hàng dự kiến khai báo khi đăng ký (UC1.1)
  shopName  String?

  // UC3.1 - Đồng ý xử lý dữ liệu cơ thể (informed consent), null = chưa đồng ý
  bodyDataConsentAt DateTime?

  // Chống dò mật khẩu (brute-force) - UC1.2
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      CustomerProfile?
  bodyProfiles BodyProfile[]
  bodyDataDeletionLogs BodyDataDeletionLog[]
  products     Product[]        @relation("SellerProducts")
  cartItems    CartItem[]
  orders       Order[]
  reviews      Review[]
  behaviors    UserBehavior[]
  addresses    Address[]
  roleLogsAsActor  RoleChangeLog[] @relation("AuditActor")
  roleLogsAsTarget RoleChangeLog[] @relation("AuditTarget")
}

// ---------- Mã OTP xác thực (UC1.1 đăng ký, UC1.3 khôi phục MK) ----------
enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  CHANGE_CONTACT
}

model OtpCode {
  id        Int        @id @default(autoincrement())
  target    String     // email hoặc SĐT nhận mã
  codeHash  String     // OTP được băm, không lưu dạng thuần
  purpose   OtpPurpose
  payload   Json?      // dữ liệu đăng ký tạm (chờ xác thực mới tạo tài khoản)
  attempts  Int        @default(0) // số lần nhập sai
  consumed  Boolean    @default(false)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@index([target, purpose])
}

// ---------- Sổ địa chỉ giao hàng (UC1.6) ----------
model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  phone         String
  province      String   // tỉnh/thành
  district      String   // quận/huyện
  ward          String   // phường/xã
  detail        String   // địa chỉ chi tiết
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// ---------- Nhật ký phân quyền (UC1.7 - bắt buộc để truy vết/kiểm toán) ----------
model RoleChangeLog {
  id           Int           @id @default(autoincrement())
  actorId      Int
  actor        User          @relation("AuditActor", fields: [actorId], references: [id])
  targetUserId Int
  target       User          @relation("AuditTarget", fields: [targetUserId], references: [id])
  roleBefore   Role
  roleAfter    Role
  statusBefore AccountStatus
  statusAfter  AccountStatus
  note         String?
  createdAt    DateTime      @default(now())

  @@index([targetUserId])
  @@index([actorId])
}

// ---------- Hồ sơ cá nhân hóa (UC2) ----------

// UC2.1c - Dịp sử dụng chuẩn (ánh xạ thuộc tính "dịp sử dụng" của sản phẩm - UC4, UC6)
enum OccasionType {
  WORK    // đi làm
  SCHOOL  // đi học
  STREET  // dạo phố
  PARTY   // tiệc & sự kiện
  SPORT   // thể thao
  TRAVEL  // du lịch
  CUSTOM  // dịp tùy chỉnh do khách hàng tự đặt (luồng 4e)
}

// UC2.1c - Mức độ thường xuyên sử dụng
enum FrequencyLevel {
  RARELY    // hiếm khi
  SOMETIMES // thỉnh thoảng
  OFTEN     // thường xuyên
}

// UC2.1 - Hồ sơ cá nhân hóa: sở thích/phong cách + ngân sách + dịp sử dụng
model CustomerProfile {
  id     Int  @id @default(autoincrement())
  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // (a) Sở thích và phong cách - danh mục chuẩn hóa, lưu dạng JSON để linh hoạt nhiều lựa chọn
  preferredStyles    Json?    // [{ style: string, priority: number }] - có ưu tiên (nhiều lựa chọn)
  preferredColors    Json?    // string[] - màu ưa thích
  avoidColors        Json?    // string[] - màu muốn tránh
  preferredGarments  Json?    // string[] - kiểu trang phục thường mặc
  avoidGarments      Json?    // string[] - kiểu trang phục không mặc
  preferredMaterials Json?    // string[] - chất liệu ưu tiên
  preferredBrands    Json?    // string[] - thương hiệu yêu thích (tùy chọn)
  styleDeclaredAt    DateTime? // null = chưa khai báo -> luồng 4b dùng gợi ý mặc định

  budgets   ProfileBudget[]   // (b) Ngân sách theo nhóm sản phẩm
  occasions ProfileOccasion[] // (c) Dịp sử dụng thường xuyên

  sizes CustomerSize[] // UC2.2 - thông tin size theo danh mục

  // UC2.3 - Đồng bộ Body Profile: tham chiếu tới bản Body Profile mới nhất đã đồng bộ.
  // onDelete SetNull -> tự hủy liên kết khi Body Profile bị xóa (UC3.4 b8).
  bodyProfileId       Int?         @unique
  bodyProfile         BodyProfile? @relation("SyncedBodyProfile", fields: [bodyProfileId], references: [id], onDelete: SetNull)
  bodyProfileSyncedAt DateTime?    // thời điểm đồng bộ gần nhất (version lấy qua bodyProfile.version)
  bodyProfileAutoSync Boolean      @default(false) // 2a - khách hàng bật tự đồng bộ khi có bản mới

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// UC2.1b - Ngân sách theo nhóm sản phẩm (đồng bộ danh mục với UC6)
model ProfileBudget {
  id         Int             @id @default(autoincrement())
  profileId  Int
  profile    CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category        @relation(fields: [categoryId], references: [id])
  minPrice   Int             // VND, số không âm
  maxPrice   Int             // VND, >= minPrice
  updatedAt  DateTime        @updatedAt

  @@unique([profileId, categoryId])
  @@index([profileId])
}

// UC2.1c - Dịp sử dụng thường xuyên đã khai báo
model ProfileOccasion {
  id          Int             @id @default(autoincrement())
  profileId   Int
  profile     CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  occasion    OccasionType
  customLabel String?         // bắt buộc khi occasion = CUSTOM (luồng 4e)
  frequency   FrequencyLevel  @default(SOMETIMES)
  createdAt   DateTime        @default(now())

  @@unique([profileId, occasion, customLabel])
  @@index([profileId])
}

// UC2.2 - Hệ size khai báo
enum SizeSystem {
  STANDARD    // S/M/L/XL...
  NUMERIC     // theo số (vd quần 29, giày EU 39)
  MEASUREMENT // nhập số đo cơ thể, hệ thống quy đổi
}

// UC2.2 - Thông tin size của khách hàng theo từng danh mục sản phẩm
model CustomerSize {
  id           Int             @id @default(autoincrement())
  profileId    Int
  profile      CustomerProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  categoryId   Int
  category     Category        @relation(fields: [categoryId], references: [id])
  sizeSystem   SizeSystem      @default(STANDARD)
  sizeValue    String          // giá trị size cuối cùng (chuẩn hoặc suy ra từ số đo)
  measurements Json?           // số đo cơ thể khi sizeSystem = MEASUREMENT
  source       String          @default("MANUAL") // MANUAL | BODY_PROFILE (dành cho UC2.3 sau này)
  updatedAt    DateTime        @updatedAt
  createdAt    DateTime        @default(now())

  @@unique([profileId, categoryId])
  @@index([profileId])
}

// ---------- Phân tích dáng người bằng AI (UC3) ----------
enum BodyShape {
  HOURGLASS
  RECTANGLE
  PEAR
  APPLE
  INVERTED_TRIANGLE
}

// UC3.1/UC3.2 - Nguồn dữ liệu đầu vào để phân tích
enum BodyProfileSource {
  MANUAL // nhập số đo thủ công
  PHOTO  // tải/chụp ảnh toàn thân (có AI hỗ trợ nhận diện dáng qua vai/hông)
}

// UC3.3 - Body Profile: mỗi lần phân tích tạo 1 bản ghi mới (lưu phiên bản, truy vết -
// bản hiện hành = bản có createdAt lớn nhất của user). UC3.1 gọi include tới UC3.2 (xử lý)
// và UC3.3 (sinh hồ sơ) để tạo ra bản ghi này.
model BodyProfile {
  id            Int               @id @default(autoincrement())
  userId        Int
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  bodyShape     BodyShape
  source        BodyProfileSource @default(MANUAL)
  version       Int               @default(1) // UC3.3 - số phiên bản; mỗi lần sinh tạo bản mới để truy vết (5a)

  height   Float? // cm
  weight   Float? // kg
  bust     Float? // vòng ngực (cm)
  waist    Float? // vòng eo (cm)
  hip      Float? // vòng hông (cm)
  shoulder Float? // rộng vai ước lượng từ ảnh, nếu có (cm hoặc tỷ lệ px)

  confidence    Float   @default(1) // độ tin cậy 0-1 (UC3.2 bước 6)
  isPreliminary Boolean @default(false) // true nếu dưới ngưỡng tin cậy -> cần hiệu chỉnh (4a UC3.3)

  photoUrl        String? // ảnh gốc; có thể bị xóa riêng theo nguyên tắc tối thiểu hóa dữ liệu (UC3.4 - 3a)
  recommendations Json? // khuyến nghị trang phục nên/không nên mặc theo dáng người (UC3.3 bước 3)
  suggestedSizes  Json? // gợi ý size sơ bộ theo danh mục, đồng bộ bảng quy đổi UC2.2 (UC3.3 bước 3)
  analysisResult  Json? // dữ liệu thô bổ sung (vd. tỷ lệ vai/hông ước lượng từ ảnh)

  createdAt DateTime @default(now())

  // UC2.3 - hồ sơ cá nhân hóa đang tham chiếu bản này (nếu đã đồng bộ)
  syncedInProfile CustomerProfile? @relation("SyncedBodyProfile")

  @@index([userId])
}

// UC3.4 - Ghi nhận tối thiểu thao tác xóa dữ liệu cơ thể (không lưu lại nội dung đã xóa)
enum BodyDataDeleteScope {
  PHOTO_ONLY  // 3a: chỉ xóa ảnh, giữ Body Profile
  PROFILE     // chỉ xóa Body Profile, giữ ảnh (hiếm dùng nhưng hỗ trợ "một phần")
  ALL         // xóa toàn bộ dữ liệu cơ thể
}

model BodyDataDeletionLog {
  id        Int                  @id @default(autoincrement())
  userId    Int
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope     BodyDataDeleteScope
  deletedAt DateTime             @default(now())

  @@index([userId])
}

// ---------- Danh mục & sản phẩm (FR3, FR6) ----------
model Category {
  id       Int       @id @default(autoincrement())
  name     String
  slug     String    @unique
  products Product[]

  // UC2.1b/UC2.2 - nhóm sản phẩm dùng để thiết lập ngân sách và size cá nhân hóa
  budgets ProfileBudget[]
  sizes   CustomerSize[]
}

model Product {
  id          Int      @id @default(autoincrement())
  sellerId    Int
  seller      User     @relation("SellerProducts", fields: [sellerId], references: [id])
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id])
  name        String
  description String?  @db.Text
  price       Int

  color    String?
  pattern  String?
  material String?
  fit      String?
  length   String?
  neckline String?
  sleeve   String?
  style    String?
  season   String?

  // UC6/Tầng A - bổ sung theo lược đồ DeepFashion2 (loại trang phục chi tiết + ngữ cảnh)
  garmentType  String? // loại trang phục chi tiết (vd "Áo tay ngắn", "Đầm tay dài", "Chân váy")
  targetGender String? // Nữ | Nam | Unisex
  brand        String? // thương hiệu (đồng bộ CustomerProfile.preferredBrands - UC2.1)
  occasion     String? // dịp dùng chính: WORK|PARTY|STREET|SPORT|TRAVEL|SCHOOL (ánh xạ UC2.1c)
  tags         Json?   // nhãn thuộc tính linh hoạt (kiểu DeepFashion attributes)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images     ProductImage[]
  variants   ProductVariant[]
  cartItems  CartItem[]
  orderItems OrderItem[]
  reviews    Review[]
  behaviors  UserBehavior[]
  bodyFits   ProductBodyFit[] // UC4 - điểm tương thích theo từng dáng người
  analysis   ProductAnalysis? // UC4.1 - kết quả phân tích thuộc tính (đề xuất + xác nhận)

  @@index([categoryId])
  @@index([sellerId])
}

// UC4.1 - trạng thái gán nhãn thuộc tính của sản phẩm
enum AnalysisStatus {
  PENDING // thiếu dữ liệu đầu vào tối thiểu (2E) - chờ bổ sung
  UNCONFIRMED // AI đã đề xuất nhãn, CHƯA được người xác nhận (8a) - vẫn dùng tạm
  CONFIRMED // Người bán/Quản trị viên đã xác nhận (8)
  FAILED // phân tích lỗi
}

// UC4.1 - tập thuộc tính đa chiều (chuẩn hóa) kèm độ tin cậy, lưu vào hồ sơ sản phẩm
model ProductAnalysis {
  id            Int            @id @default(autoincrement())
  productId     Int            @unique
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  status        AnalysisStatus @default(UNCONFIRMED)
  engine        String         @default("rule") // rule | rule+image
  attributes    Json? // { color:'navy', style:'classic', material:'knit', ... } (mã chuẩn)
  confidence    Json? // { color:0.9, style:0.6, ... } độ tin cậy từng nhãn
  occasion      String? // dịp sử dụng suy ra (mã chuẩn, ánh xạ UC2.1)
  bodyShapes    Json? // top dáng phù hợp [{bodyShape, score}] (ánh xạ UC3)
  lowConfidence Json? // nhãn độ tin cậy thấp -> ưu tiên người xem lại (quy tắc nghiệp vụ)
  note          String?
  analyzedAt    DateTime       @default(now())
  confirmedAt   DateTime?
  confirmedBy   Int?
  updatedAt     DateTime       @updatedAt
}

// UC4 (GĐ4) - Điểm tương thích giữa sản phẩm và từng dáng người, sinh từ Fashion
// Knowledge Base (constants/fashion-kb.ts) áp lên thuộc tính sản phẩm.
model ProductBodyFit {
  id        Int       @id @default(autoincrement())
  productId Int
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  bodyShape BodyShape
  score     Float     // 0..1 - càng cao càng hợp dáng
  reasons   Json?     // các lý do khớp/không khớp (phục vụ giải thích ở UC5)
  updatedAt DateTime  @updatedAt

  @@unique([productId, bodyShape])
  @@index([productId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean @default(false)
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  stock     Int     @default(0)

  cartItems  CartItem[]
  orderItems OrderItem[]

  @@unique([productId, size])
}

// ---------- Giỏ hàng & đơn hàng (FR6) ----------
model CartItem {
  id        Int             @id @default(autoincrement())
  userId    Int
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())

  @@index([userId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPING
  COMPLETED
  CANCELLED
}

model Order {
  id        Int         @id @default(autoincrement())
  userId    Int
  user      User        @relation(fields: [userId], references: [id])
  status    OrderStatus @default(PENDING)
  total     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        Int             @id @default(autoincrement())
  orderId   Int
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product         @relation(fields: [productId], references: [id])
  variantId Int?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int
  price     Int
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  rating    Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([productId])
}

enum BehaviorAction {
  VIEW
  WISHLIST
  ADD_TO_CART
  PURCHASE
}

model UserBehavior {
  id        Int            @id @default(autoincrement())
  userId    Int
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  action    BehaviorAction
  createdAt DateTime       @default(now())

  @@index([userId])
  @@index([productId])
  @@index([action])
}

// ============================================================
//  UC4.2 - TRI THỨC THỜI TRANG (quản lý bởi Quản trị viên)
//  (a) Danh mục thuộc tính chuẩn dùng chung  (b) Luật hợp dáng
//  Nguồn tham chiếu cho chuẩn hóa nhãn SP (UC4.1), khuyến nghị (UC3.3), gợi ý (UC5).
// ============================================================

enum AttributeType {
  GARMENT // loại trang phục
  COLOR // màu sắc
  MATERIAL // chất liệu
  FIT // phom dáng
  NECKLINE // cổ áo
  SLEEVE // tay áo
  LENGTH // độ dài
  STYLE // phong cách
  OCCASION // dịp sử dụng
  PATTERN // họa tiết
  BODY_SHAPE // dáng người phù hợp
}

// (a) Danh mục thuộc tính chuẩn — mỗi value có mã chuẩn + nhãn + alias để chuẩn hóa
// giá trị tự do của sản phẩm (vd "Xanh navy" -> navy). Dùng chung với UC2/UC3/UC7.
model FashionAttribute {
  id        Int           @id @default(autoincrement())
  type      AttributeType
  code      String // mã chuẩn (vd 'navy', 'office', 'Slim')
  label     String // nhãn hiển thị (VN)
  aliases   Json? // mảng biến thể tự do để ánh xạ về code (UC4.1 chuẩn hóa)
  active    Boolean       @default(true) // false = vô hiệu hóa (không xóa cứng - UC4.2 4c)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([type, code])
  @@index([type])
}

enum FitRuleKind {
  PREFER // ưu tiên (+)
  AVOID // nên tránh (-)
}

// (b) Luật hợp dáng: dáng người ↔ thuộc tính (fit/neckline/length/sleeve) kèm trọng số + lý do.
// Chuyển từ FASHION_KB hard-code vào DB để Admin quản lý (UC4.2).
model ShapeFitRule {
  id        Int         @id @default(autoincrement())
  bodyShape BodyShape
  attr      String // fit | neckline | length | sleeve
  value     String // giá trị thuộc tính (khớp giá trị trên sản phẩm)
  kind      FitRuleKind
  weight    Float
  reason    String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([bodyShape])
}

enum KnowledgeEntity {
  ATTRIBUTE
  FIT_RULE
  PAIRING_RULE
}

enum KnowledgeAction {
  CREATE
  UPDATE
  DELETE
  DEACTIVATE
  IMPORT
}

// Nhật ký + phiên bản thay đổi tri thức (UC4.2 - truy vết). actorId = id Quản trị viên.
model KnowledgeAudit {
  id        Int             @id @default(autoincrement())
  entity    KnowledgeEntity
  entityId  Int?
  action    KnowledgeAction
  actorId   Int?
  before    Json?
  after     Json?
  note      String?
  createdAt DateTime        @default(now())

  @@index([entity])
  @@index([actorId])
