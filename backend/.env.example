# ==== Backend environment ====
NODE_ENV=development
PORT=4000

# Kết nối MySQL — đổi user/password/tên DB cho đúng máy bạn
DATABASE_URL="mysql://root:password@localhost:3306/dresssense"

# JWT
JWT_SECRET="dev_secret_change_me"
JWT_EXPIRES_IN="7d"
JWT_REMEMBER_EXPIRES_IN="30d"   # thời hạn khi chọn "Ghi nhớ đăng nhập"

# CORS
CLIENT_ORIGIN="http://localhost:5173"

# Google OAuth - lấy tại Google Cloud Console (OAuth 2.0 Web client)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# GĐ7 - AI service (Python/FastAPI). Trống = tắt tích hợp, backend tự tính bằng luật.
AI_SERVICE_URL="http://localhost:8000"

# UC9.2 - VNPAY sandbox. Đăng ký miễn phí tại https://sandbox.vnpayment.vn để lấy
# TMN code + Hash secret. Để trống = tắt thanh toán online (COD vẫn hoạt động).
VNP_TMN_CODE=""
VNP_HASH_SECRET=""
VNP_URL="https://sandbox.vnpayment.vn/paymentv2/vnpaymenthtml"
VNP_RETURN_URL="http://localhost:4000/api/payments/vnpay/return"
