# ==== Backend environment ====
# Cổng chạy API server
PORT=4000

# Kết nối MySQL — đổi user/password/tên DB cho đúng máy bạn
DATABASE_URL="mysql://root:password@localhost:3306/dresssense"

# Khóa bí mật ký JWT — đổi thành chuỗi ngẫu nhiên dài khi triển khai thật
JWT_SECRET="dev_secret_change_me"
JWT_EXPIRES_IN="7d"

# Nguồn frontend được phép gọi API (CORS)
CLIENT_ORIGIN="http://localhost:5173"
