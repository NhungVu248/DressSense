# ====== Cấu hình Docker Compose cho DressSense ======
# Sao chép file này thành .env rồi điền giá trị:   cp .env.docker.example .env
# (file .env đã được .gitignore - không commit bí mật)

# --- MySQL ---
# Dùng mật khẩu đơn giản (chữ + số), tránh ký tự đặc biệt vì nằm trong DATABASE_URL.
MYSQL_ROOT_PASSWORD=dresssense123
MYSQL_DATABASE=dresssense

# --- Cổng web nội bộ (Nginx) ---
WEB_PORT=8080

# --- URL công khai của ứng dụng ---
# Local (chưa ngrok):   http://localhost:8080
# Khi dùng ngrok:       https://<ten-mien-cua-ban>.ngrok-free.app
PUBLIC_URL=http://localhost:8080

# --- Bảo mật JWT (ĐỔI khi chạy thật) ---
JWT_SECRET=doi_chuoi_bi_mat_nay_khi_chay_that

# --- Seed dữ liệu mẫu lần đầu (true = tạo tài khoản/sản phẩm/khuyến mãi mẫu) ---
SEED_ON_START=true

# --- Google OAuth (tùy chọn; để trống nếu không dùng đăng nhập Google) ---
GOOGLE_CLIENT_ID=

# --- ngrok (công khai ra Internet; chỉ cần khi chạy profile "tunnel") ---
# 1) Đăng ký miễn phí tại https://dashboard.ngrok.com
# 2) Lấy authtoken ở mục "Your Authtoken"
# 3) Tạo "Static Domain" miễn phí ở mục "Domains" (vd: dresssense-abcd.ngrok-free.app)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=

# --- VNPAY sandbox (tùy chọn; để trống = chỉ COD, tắt thanh toán online) ---
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vnpaymenthtml
